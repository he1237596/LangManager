# LangManager 自托管部署所需环境变量
#
# 用法：
#   1. 复制本文件为同目录下的 .env（docker/.env）
#   2. 修改下面所有带 <...> 的占位符
#   3. 在项目根目录执行：docker compose -f docker/docker-compose.yml up -d
#
# 注意：docker/.env 切勿提交到 git（已在根 .gitignore 中忽略 docker/.env）

# ============================================================
# 1. 对外访问地址（浏览器访问的前端地址 + Supabase API 地址）
#    如果你有域名：http(s)://your.domain
#    本地测试：http://localhost:8000
#    前端会用 VITE_SUPABASE_URL 访问 /rest/v1、/auth/v1；翻译走 VITE_TRANSLATE_URL
# ============================================================
PUBLIC_DOMAIN=http://localhost:8000

# ============================================================
# 2. Supabase 自托管核心密钥
#    务必改成强随机值！可用以下命令生成：
#      openssl rand -base64 32
#    这些密钥一旦修改，已签发的 JWT 会失效（需重新登录）
# ============================================================
POSTGRES_PASSWORD=change_me_strong_postgres_password
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
ENCRYPTION_KEY=change_me_encryption_key_32bytes_long

# anon key / service_role key 由本目录下的脚本根据 JWT_SECRET 自动生成
# （docker-compose 启动时通过 init-supabase-keys 容器写入 .env.keys）
# 如你已自行生成，可取消下面两行注释并填入，否则留空即可自动生成：
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# 3. Studio（Supabase 后台）登录密码
# ============================================================
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change_me_dashboard_password

# ============================================================
# 4. 邮件配置（密码重置 / 邀请邮件）
#    自托管不提供邮件服务，必须配置 SMTP 才能收发邮件。
#    可用腾讯企业邮 / 阿里邮 / 任意 SMTP。
#    若不配置，注册仍可正常（账号写入库），但密码重置邮件发不出去。
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@your-domain.com

# ============================================================
# 5. 前端构建参数（构建时注入，决定前端连哪个 Supabase）
#    VITE_SUPABASE_URL 必须等于 PUBLIC_DOMAIN（前端与函数同源）
# ============================================================
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
# AI 翻译服务地址（自托管版为 docker/translate 容器，经 Kong 暴露）
# 同源路径即可，留空则前端提示"未配置翻译服务"
VITE_TRANSLATE_URL=http://localhost:8000/translate/v1/translate

# ============================================================
# 7. 翻译服务用的腾讯云机器翻译（TMT）密钥
#    在 https://console.cloud.tencent.com/cam/capi 获取 SecretId/SecretKey
#    不填则翻译服务启动但调用时报"未配置密钥"
# ============================================================
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# ============================================================
# 6. 初始化数据库用的管理员账号（init.sql 会创建）
# ============================================================
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=admin123
